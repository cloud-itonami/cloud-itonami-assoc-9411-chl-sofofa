      (string=? candidate "ethics") 7
      (string=? candidate "governance") 21
      (string=? candidate "history") 4
      (string=? candidate "labor") 1
      (string=? candidate "membership") 4
      (string=? candidate "policy") 1
      (string=? candidate "statute") 17
      :else 0)
    0))

